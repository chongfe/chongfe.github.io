---
import type { Friend } from '../config/friends';
import Icon from './Icon.astro';
interface Props { friend: Friend; }
const { friend } = Astro.props;
const url = new URL(friend.url);
if (!['https:', 'http:'].includes(url.protocol)) throw new Error(`Invalid friend URL: ${friend.url}`);
---
<a class="friend-card" href={friend.url} target="_blank" rel="noopener noreferrer">
  <span class="friend-avatar">{friend.avatar ? <img src={friend.avatar} alt="" width="48" height="48" loading="lazy" /> : friend.name.slice(0, 1)}</span>
  <div><h3>{friend.name}</h3><p>{friend.description}</p><span>{url.hostname}</span></div><Icon name="external" />
</a>
