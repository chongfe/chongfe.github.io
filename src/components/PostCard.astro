---
import type { CollectionEntry } from 'astro:content';
import { entryUrl, formatDate, readingTime } from '../lib/content';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'blog'>; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const { title, description, date, category, tags } = entry.data;
---
<article class:list={['post-card', { featured }]} data-search={`${title} ${description} ${category} ${tags.join(' ')}`} data-category={category}>
  <div class="post-meta"><span class="tag">{category}</span><time datetime={date.toISOString()}>{formatDate(date)}</time><span>{readingTime(entry.body)} 分钟阅读</span></div>
  <h3><a href={entryUrl(entry)}>{title}</a></h3><p>{description}</p>
  <a class="text-link" href={entryUrl(entry)}>阅读文章 <Icon /></a>
  {featured && <svg class="post-watermark" aria-hidden="true" viewBox="0 0 175 90"><text x="3" y="68" fill="currentColor">hello_</text></svg>}
</article>
