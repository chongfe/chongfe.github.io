---
import type { CollectionEntry, CollectionKey } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { formatDate, readingTime, entryUrl } from '../lib/content';
import { site } from '../config/site';
interface Props { entry: CollectionEntry<CollectionKey>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const label = { blog: '博客', docs: '笔记', research: '科研' }[entry.collection];
const { title, description, date, category, updated, tags } = entry.data;
const links = 'links' in entry.data ? entry.data.links : [];
---
<Base title={title} description={description} article><div class="article-wrap"><a class="back-link" href={`/${entry.collection}/`}>← 返回{label}</a><header class="article-header"><div class="post-meta"><span class="tag">{category}</span><time datetime={date.toISOString()}>{formatDate(date)}</time><span>{readingTime(entry.body)} 分钟阅读</span>{updated && <span>更新于 {formatDate(updated)}</span>}</div><h1>{title}</h1><p>{description}</p><div class="byline"><span class="mini-avatar">R</span>R1ck5<span>记录与分享</span></div>{links.length > 0 && <div class="resource-links">{links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}</header><div class="article-grid"><article class="prose"><Content />{tags.length > 0 && <div class="resource-links">{tags.map(tag => <span class="tag">{tag}</span>)}</div>}<div class="article-end"><span>感谢读到这里。</span><button class="text-link copy-button" data-copy={`${site.url}${entryUrl(entry)}`} hidden>复制文章链接 <Icon /></button><span class="copy-status" aria-live="polite"></span></div><div class="article-navigation"><a href={`/${entry.collection}/`}>← 全部{label}</a><a href="/feed.xml">RSS 订阅 <Icon name="rss" /></a></div></article><aside class="toc"><span class="small-label">本文目录</span><nav aria-label="文章目录">{headings.filter(h=>h.depth<=3).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div></div></Base>
