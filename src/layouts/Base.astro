---
import { site } from '../config/site';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = site.description, article = false } = Astro.props;
const pathname = Astro.url.pathname;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={new URL(pathname, site.url)} />
    <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={new URL(pathname, site.url)} /><meta property="og:image" content={`${site.url}/assets/social.png`} /><meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" /><link rel="alternate" type="application/rss+xml" title="R1ck5 RSS" href="/feed.xml" />
    <script is:inline src="/assets/theme.js"></script><script is:inline src="/assets/app.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href="/" aria-label="R1ck5 首页"><span class="brand-mark"><img src={site.avatar} width="36" height="36" alt="" /></span><span>R1ck5<span class="brand-dot">.</span></span></a>
      <nav aria-label="主导航">{site.navigation.map(({ href, label }) => <a href={href} aria-current={(href === '/' ? pathname === '/' : pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><a class="github-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub（新窗口）"><Icon name="github" /><span>GitHub</span><Icon name="external" /></a><span class="divider"></span><button class="icon-button" id="theme-toggle" hidden aria-label="切换深色模式" title="切换主题"><Icon name="sun" /></button></div>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><a class="brand" href="/">R1ck5<span class="brand-dot">.</span></a><span>{site.tagline}</span><div><a href="/feed.xml"><Icon name="rss" /> RSS</a><a href={site.repository} target="_blank" rel="noopener noreferrer">本站源码 <Icon name="external" /></a></div></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} R1ck5 · Built with curiosity.</span><span>在自己的角落，记录与连接 <span class="tiny-spark">✳</span></span></div></footer>
  </body>
</html>
