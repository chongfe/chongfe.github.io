---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import FriendCard from '../../components/FriendCard.astro';
import Icon from '../../components/Icon.astro';
import { friends, bookmarks } from '../../config/friends';
import { site } from '../../config/site';
const applyUrl = `${site.repository}/issues/new?template=friend-link.yml`;
const info = `名称：R1ck5\n网址：https://chongfe.github.io/\n介绍：${site.tagline}\n图标：${site.url}${site.avatar}`;
---
<Base title="友链"><div class="page-wrap"><PageHead en="GOOD COMPANY" title="在别处相遇" description="从一个小站，走向另一个小站。让好奇心把我们连接起来。" /><section><div class="section-heading"><h2>朋友们<span>FRIENDS</span></h2><a href={applyUrl} target="_blank" rel="noopener noreferrer">交换友链 <Icon name="external" /></a></div>{friends.length ? <div class="friends-grid">{friends.map(friend => <FriendCard friend={friend} />)}</div> : <div class="friends-empty"><span class="little-star">✳</span><div><h3>为新的相遇，留一个位置。</h3><p>友链席位开放中。如果你也有自己的小站，欢迎来打个招呼。</p></div></div>}</section><section class="bookmarks"><div class="section-heading"><h2>值得一逛<span>BOOKMARKS</span></h2><span class="muted">单向收藏 · 非互链</span></div><div class="friends-grid">{bookmarks.map(friend => <FriendCard friend={friend} />)}</div></section><section class="exchange-panel"><div><span class="small-label">LET’S CONNECT</span><h2>交换一扇窗</h2><p>欢迎持续更新、有原创内容的个人网站。<br />留下名称、网址和一句介绍，我会在确认后添加。</p><a class="button primary" href={applyUrl} target="_blank" rel="noopener noreferrer">申请友链 <Icon name="external" /></a><p class="fine-print">通过 GitHub Issue 申请，需要登录 GitHub。</p></div><div class="site-info"><span class="small-label">本站信息</span><dl><dt>名称</dt><dd>R1ck5</dd><dt>网址</dt><dd>https://chongfe.github.io/</dd><dt>介绍</dt><dd>{site.tagline}</dd><dt>图标</dt><dd><a class="avatar-link" href={site.avatar}><img src={site.avatar} width="48" height="48" alt="R1ck5 的头像" /><span>{site.avatar}</span></a></dd></dl><button class="text-link copy-button" data-copy={info} hidden>复制本站信息 <Icon /></button><span class="copy-status" aria-live="polite"></span></div></section></div></Base>
